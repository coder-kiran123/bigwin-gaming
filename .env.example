# Copy to .env (local) or set these as environment variables on your host (Railway, Render…).
# NEVER commit the real .env file.

# Admin panel password (/admin). Admin login is disabled until this is set.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign login sessions. Use a long random string, e.g. `python3 -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=

# Database. Leave empty for local SQLite (server/casino.db). Use PostgreSQL in production.
DATABASE_URL=

# Public website address (used in emails)
SITE_URL=https://bigwingaming.com

# Firebase project ID (Google sign-in). Same value as projectId in assets/js/firebase-config.js
FIREBASE_PROJECT_ID=

# Optional: restrict which website may call the API (default *)
ALLOWED_ORIGIN=*
